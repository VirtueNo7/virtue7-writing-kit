{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtue7.example/schemas/artifact-record.schema.json",
  "title": "Virtue7 Artifact Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "artifact_id", "version", "sha256",
    "state", "source_lineage", "validation_state", "unresolved_questions"
  ],
  "properties": {
    "schema_version": {"const": "0.5.0"},
    "project_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previous_version_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "state": {"enum": ["draft", "revision_requested", "revised_draft", "approved", "exported", "released"]},
    "source_lineage": {"type": "array", "items": {"type": "string"}},
    "validation_state": {"enum": ["not_evaluated", "structural_pass", "reviewed", "blocked"]},
    "approval_receipt_id": {"type": "string", "pattern": "^APR-[A-Za-z0-9._-]+$"},
    "approval_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["approved", "exported", "released"]}}},
      "then": {"required": ["approval_receipt_id", "approval_artifact_sha256"]}
    }
  ]
}
